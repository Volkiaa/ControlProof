{
  "workflow": "testdata/golden/self-hosted.yml",
  "name": "Self hosted",
  "trust": "trusted-definition",
  "triggers": [
    {
      "event": "push",
      "pos": {
        "file": "testdata/golden/self-hosted.yml",
        "line": 3,
        "col": 3
      },
      "modeled": true,
      "attacker_control": "conditional"
    }
  ],
  "prerequisites": [
    {
      "setting": "branch_protection",
      "description": "pushes to main are restricted to trusted committers"
    },
    {
      "setting": "self_hosted_runner_isolation",
      "description": "self-hosted runner is not shared with less-trusted workflows",
      "pos": {
        "file": "testdata/golden/self-hosted.yml",
        "line": 6,
        "col": 3
      }
    }
  ]
}
